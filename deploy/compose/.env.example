# Copia questo file in .env prima del primo avvio:
#   cp .env.example .env
#
# .env è ignorato da git. I valori qui sotto sono credenziali di sviluppo locale,
# usa e getta: in Kubernetes arrivano da Secret, su AWS da Secrets Manager.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=media
POSTGRES_PASSWORD=cambiami-solo-locale
POSTGRES_DB=media
POSTGRES_PORT=5432

# --- MongoDB -----------------------------------------------------------------
MONGO_USER=media
MONGO_PASSWORD=cambiami-solo-locale
MONGO_DATABASE=media
MONGO_PORT=27017

# --- RabbitMQ ----------------------------------------------------------------
RABBITMQ_USER=media
RABBITMQ_PASSWORD=cambiami-solo-locale
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- MinIO -------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=cambiami-solo-locale
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Endpoint su cui vengono firmati i presigned URL. Deve essere raggiungibile
# dal browser, non dalla rete interna di compose: il file viene caricato dal
# client direttamente sull'object storage.
S3_ENDPOINT_PUBLIC=http://localhost:9000

# --- Applicazione ------------------------------------------------------------
JWT_SECRET=cambiami-con-almeno-32-caratteri-a-caso
FRONTEND_PORT=8080
API_PORT=8000
