# Configurazione dello stack di prova. Versionata apposta: non contiene segreti
# veri, solo valori usa e getta per un ambiente che nasce e muore con i test.
#
# Due differenze rispetto a .env, ed entrambe contano:
#
# 1. le porte sono spostate, così lo stack di prova convive con quello di
#    sviluppo senza litigare per le stesse porte del Mac;
# 2. S3_ENDPOINT_PUBLIC è l'indirizzo *interno* dell'archivio. Nello sviluppo
#    quell'indirizzo deve essere raggiungibile dal browser; nei test chi carica
#    il file è un container dentro la rete, e "localhost" per lui è sé stesso.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=media
POSTGRES_PASSWORD=solo-per-i-test
POSTGRES_DB=media
POSTGRES_PORT=15432

# --- MongoDB -----------------------------------------------------------------
MONGO_USER=media
MONGO_PASSWORD=solo-per-i-test
MONGO_DATABASE=media
MONGO_PORT=27018

# --- RabbitMQ ----------------------------------------------------------------
RABBITMQ_USER=media
RABBITMQ_PASSWORD=solo-per-i-test
RABBITMQ_PORT=15673
RABBITMQ_MANAGEMENT_PORT=25673

# --- MinIO -------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=solo-per-i-test
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
S3_ENDPOINT_PUBLIC=http://minio:9000

# --- Applicazione ------------------------------------------------------------
JWT_SECRET=chiave-di-prova-lunga-almeno-32-caratteri
FRONTEND_PORT=18080
API_PORT=18000
